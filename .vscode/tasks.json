{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo build --workspace",
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "cargo test",
      "type": "shell",
      "command": "cargo test --workspace",
      "problemMatcher": ["$rustc"],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "bmp-probe list",
      "type": "shell",
      "command": "cargo run -p bmp-probe -- list",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "bmp-probe tiles",
      "type": "shell",
      "command": "cargo run -p bmp-probe -- tiles",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "bmp-probe tiles --json",
      "type": "shell",
      "command": "cargo run -p bmp-probe -- tiles --json",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "app: tauri dev",
      "type": "shell",
      "command": "npm run tauri dev",
      "options": { "cwd": "${workspaceFolder}/app" },
      "isBackground": true,
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "app: svelte check",
      "type": "shell",
      "command": "npm run check",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": []
    }
  ]
}
