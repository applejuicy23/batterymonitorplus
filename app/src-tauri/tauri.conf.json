{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BatteryMonitor+",
  "version": "0.3.0",
  "identifier": "com.applejuicy23.batterymonitorplus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BatteryMonitor+",
        "width": 760,
        "height": 600,
        "minWidth": 560,
        "minHeight": 420
      },
      {
        "label": "tiles",
        "title": "BatteryMonitor+ tiles",
        "url": "/tiles",
        "width": 120,
        "height": 48,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
